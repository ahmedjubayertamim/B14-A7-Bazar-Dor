# Server-only MongoDB and Better Auth settings
MONGODB_URI=
MONGODB_DB=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Browser-visible Better Auth base URL. Do not add a trailing slash.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# OAuth provider credentials (server-only; leave blank until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Non-secret browser flags; set to true only when the matching provider
# credentials are configured on the server.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_GITHUB_AUTH_ENABLED=false

# Production: set both auth URLs to https://bazar-dor-ahmedjubayertamim.vercel.app
# and use a BETTER_AUTH_SECRET containing at least 32 random characters.
